# ==========================================================================
# CBNU Research Group Web - .gitignore
# ==========================================================================

# ── Operating System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp

# ── Private Photos & Admin Docs ──
ADMIN_GUIDE.md
*ADMIN*.md
admin-guide/
images/private/
images/drafts/
data/drafts/
*.heic
*.HEIC
*.raw
*.RAW
*.cr2
*.nef

# ── Personal Local Scripts & Tools ──
*.bat
scripts/
*.ps1

# ── IDE & Editor Settings ──
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.claude/
.gemini/
.agents/

# ── Build Outputs & Platform Caches ──
dist/
build/
out/
.netlify/
.vercel/
.cache/
.temp/

# ── Node.js / Package Manager ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment & Secrets ──
.env
.env.*
*.pem
*.key

# ── Logs ──
logs/
*.log
