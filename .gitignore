# ==========================================================================
# CBNU Research Group Web - .gitignore
# ==========================================================================

# ── Operating System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp

# ── Private / RAW Photos & Uncompressed Media ──
*.heic
*.HEIC
*.raw
*.RAW
*.cr2
*.nef
private/
images/private/
images/drafts/
data/drafts/

# ── IDE & Editor Settings ──
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.claude/
.gemini/
.agents/

# ── Node.js / Package Manager ──
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment & Secrets ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ── Logs & Temporary Caches ──
logs/
*.log
.cache/
.temp/
